{
  "name": "1337x-auto-links",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chromium MV3 extension that injects Magnet and .torrent buttons into 1337x result rows.",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "icons": "node scripts/icons.mjs",
    "zip": "node scripts/build.mjs --zip",
    "watch": "node scripts/build.mjs --watch",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.3.0",
    "@types/node": "26.6.2",
    "adm-zip": "0.6.1",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "happy-dom": "20.14.5",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
